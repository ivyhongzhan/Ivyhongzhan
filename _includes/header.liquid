<header class="site-header">
  <nav class="site-navigation" aria-label="Primary navigation">
    <div class="site-navigation-inner">
      <a class="site-wordmark" href="{{ '/' | relative_url }}">Hong (Ivy) Zhan</a>
      <ul class="site-navigation-links">
        <li>
          <a
            href="{{ '/' | relative_url }}"
            {% if page.permalink == '/' %}
              aria-current="page"
            {% endif %}
            >About</a
          >
        </li>
        <li>
          <a
            href="{{ '/research/' | relative_url }}"
            {% if page.permalink contains '/research/' %}
              aria-current="page"
            {% endif %}
            >Research</a
          >
        </li>
      </ul>
    </div>
  </nav>
</header>
